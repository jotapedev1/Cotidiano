<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/grafo_navegacao"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.cotidiano.ui.autenticacao.LoginFragment"
        android:label="@string/acao_entrar">
        <action
            android:id="@+id/acao_login_para_inicio"
            app:destination="@id/inicioFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/acao_login_para_cadastro"
            app:destination="@id/cadastroFragment" />
    </fragment>

    <fragment
        android:id="@+id/cadastroFragment"
        android:name="com.example.cotidiano.ui.autenticacao.CadastroFragment"
        android:label="@string/cadastro_rotulo">
        <action
            android:id="@+id/acao_cadastro_para_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/inicioFragment"
        android:name="com.example.cotidiano.ui.inicio.InicioFragment"
        android:label="@string/nav_hoje" />
    <fragment
        android:id="@+id/metasFragment"
        android:name="com.example.cotidiano.ui.metas.MetasFragment"
        android:label="@string/nav_metas" />
    <fragment
        android:id="@+id/obrigacoesFragment"
        android:name="com.example.cotidiano.ui.obrigacoes.ObrigacoesFragment"
        android:label="@string/nav_obrigacoes" />
    <fragment
        android:id="@+id/pomodoroFragment"
        android:name="com.example.cotidiano.ui.pomodoro.PomodoroFragment"
        android:label="@string/pomodoro" />
    <fragment
        android:id="@+id/cronogramaFragment"
        android:name="com.example.cotidiano.ui.cronograma.CronogramaFragment"
        android:label="@string/nav_cronograma" />
</navigation>