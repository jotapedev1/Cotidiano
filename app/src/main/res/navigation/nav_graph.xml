<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.cotidiano.ui.login.LoginFragment"
        android:label="Login">
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_login_to_cadastro"
            app:destination="@id/signupFragment" />
    </fragment>

    <fragment
        android:id="@+id/signupFragment"
        android:name="com.example.cotidiano.ui.signup.SignupFragment"
        android:label="Signup">
        <action
            android:id="@+id/action_cadastro_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.cotidiano.ui.home.HomeFragment"
        android:label="Hoje" />
    <fragment
        android:id="@+id/goalsFragment"
        android:name="com.example.cotidiano.ui.goals.GoalsFragment"
        android:label="Metas" />
    <fragment
        android:id="@+id/choresFragment"
        android:name="com.example.cotidiano.ui.chores.ChoresFragment"
        android:label="Obrigações" />
    <fragment
        android:id="@+id/pomodoroFragment"
        android:name="com.example.cotidiano.ui.pomodoro.PomodoroFragment"
        android:label="Pomodoro" />
    <fragment
        android:id="@+id/scheduleFragment"
        android:name="com.example.cotidiano.ui.schedule.ScheduleFragment"
        android:label="Cronograma" />
</navigation>